rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.admin == true;
    }

    // Public app assets (icons, screenshots)
    match /app-assets/{appId}/{asset=**} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource != null && request.resource.size < 15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Staging APK uploads (up to 500MB)
    match /staging/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource != null && request.resource.size < 500 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Published APKs - Publicly downloadable directly by any mobile client without authentication
    // Deletes restricted to verified administrators
    match /published/{appId}/{versionId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource != null && request.resource.size < 500 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Wildcard fallback for all published app files and directories
    match /published/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource != null && request.resource.size < 500 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Direct APK storage paths
    match /apks/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource != null && request.resource.size < 500 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
