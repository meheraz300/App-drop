rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mh3620305@gmail.com" && request.auth.token.email_verified == true
      );
    }

    // Public app assets (icons, screenshots)
    match /app-assets/{appId}/{asset=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
    }

    // Staging APK uploads (Admin only, up to 500MB)
    match /staging/{sessionId}/{fileName} {
      allow read, write: if isAdmin() && request.resource.size < 500 * 1024 * 1024;
    }

    // Published APKs (Publicly downloadable for distribution)
    match /published/{appId}/{versionId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
