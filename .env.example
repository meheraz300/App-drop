# Administrator Email (configure with your authorized Google account email)
VITE_ADMIN_EMAIL="admin@example.com"

# Maximum APK upload size in bytes (defaults to 500 MB)
VITE_MAX_APK_SIZE_BYTES=524288000

# Firebase Web Client Configuration (populate from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Optional Public Webhook URL for Client-Triggered Deploys
VITE_DEPLOY_HOOK_URL=""

# Server-Only CI/CD Dispatch Secrets (NEVER prefix secrets with VITE_)
GITHUB_REPO=""
GITHUB_TOKEN=""
DEPLOY_HOOK_URL=""
